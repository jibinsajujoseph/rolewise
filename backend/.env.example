# Configuration for Rolewise Backend
# ----------------------------------

# KEY_SOURCE defines whether the user must provide the API key (BYOK) 
# or if it's provided by the server environment.
# Valid values: "byok" | "server"
KEY_SOURCE=server

# If KEY_SOURCE=server, the frontend will not ask the user for a key, 
# and the backend will use this key for all requests.
# GEMINI_API_KEY=your_gemini_api_key_here

# Allowed origins for CORS. Default is http://localhost:5173 if unset.
# For production, set this to your frontend URL (comma-separated for multiple).
# CORS_ORIGINS=https://rolewise.example.com

# Maximum upload size in megabytes (default 5)
MAX_UPLOAD_MB=5

# Rate limit for LLM endpoints (e.g. 10/hour, 5/minute)
RATE_LIMIT="10/hour"

# Demo access code required for LLM endpoints.
# If unset, no access code check is performed.
# ACCESS_CODE=my-secret-demo-code
