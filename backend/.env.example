# Configuration for Rolewise Backend
# ----------------------------------

# KEY_SOURCE defines whether the user must provide the API key (BYOK) 
# or if it's provided by the server environment.
# Valid values: "byok" | "server"
KEY_SOURCE=byok

# If KEY_SOURCE=server, the frontend will not ask the user for a key, 
# and the backend will use these keys for all requests.
# Uncomment and add API keys for the providers you want to support.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
